LLM_API_KEY=
LLM_ENDPOINT=
LLM_MODEL=gemini-2.5-flash
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=llama3.2:3b

# Storage paths
UPLOAD_FOLDER=backend/data/uploads
AUDIO_FOLDER=backend/data/audio
