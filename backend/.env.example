# Database configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:<password>@ep-royal-mountain-b7tfmfxv-pooler.c-13.us-east-1.aws.neon.tech/kare_viva_db?sslmode=require

# App Security
SECRET_KEY=kare-viva-secret-key-2026-production-kalasalingam
JWT_SECRET_KEY=kare-jwt-super-secret-key-2026-viva-system
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server
PORT=5001
DEBUG=True

# NVIDIA Nemotron ASR
NEMOTRON_API_KEY=
NEMOTRON_ENDPOINT=https://integrate.api.nvidia.com/v1/audio/transcriptions
NEMOTRON_MODEL=nvidia/nemotron-3.5-asr-streaming-0.6b
USE_MOCK_ASR_IF_NO_KEY=True

# LLM Answer Evaluator (Google Gemini, OpenAI-compatible, or NVIDIA Nim)
